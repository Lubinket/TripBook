<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base app theme. Inherits from Material3 DayNight for automatic
        light/dark mode support.
    -->
    <style name="Theme.TripBook" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand colors wired into Material3 color roles -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOutline">@color/outline</item>

        <!-- Status bar: match primary color -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Font: using system default (sans-serif). Add Poppins later via res/font/ if desired. -->
    </style>

    <!--
        Splash screen theme.
        Uses a solid primary color background so the window background
        matches before our layout is inflated (eliminates white flash).
    -->
    <style name="Theme.TripBook.Splash" parent="Theme.TripBook">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary</item>
    </style>

    <!--
        Text appearance for the CollapsedToolbar title on SiteDetailFragment.
    -->
    <style name="TextAppearance.TripBook.CollapsingToolbar"
        parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
    </style>

    <!--
        Text appearance overrides for Material components
        (buttons, chips, labels use Poppins consistently).
    -->
    <style name="TextAppearance.TripBook.Button"
        parent="TextAppearance.Material3.LabelLarge">
    </style>

</resources>