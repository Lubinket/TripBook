<?xml version="1.0" encoding="utf-8"?>
<!--
    Region tag pill background on SiteDetailFragment.
    A rounded rectangle with a primary-color stroke and a very light tint fill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="20dp" />

    <stroke
        android:width="1dp"
        android:color="@color/primary" />

    <solid android:color="#1A0D2B5E" />
    <!-- 10% opacity primary blue fill -->

</shape>